<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>RawBankEditor</RootNamespace>
		<AssemblyName>RawBankEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>RawBankEditor.Program</StartupObject>
		<ApplicationIcon>raw.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
		<!-- Orezanie výstupu pre inštalátor - rovnako ako v GVDEditor.csproj.
		     Bez RID kopíruje SDK do runtimes\ aj natívne knižnice pre Android, Linux a macOS.
		     AppendRuntimeIdentifierToOutputPath=false: inak by výstup skončil v podpriečinku
		     win-x64 a rozbil cesty v RawBankEditorInstaller.iss. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- Slovenčina je v hlavnej zostave, preložená je len čeština. -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.WinForms" Version="2.2.1" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="raw.ico" />
		<!-- Licencie sú v koreni repozitára, spoločné pre celý projekt.
		     Link určuje, kam sa skopírujú vo výstupe - bez neho by skončili v jeho koreni. -->
		<Content Include="..\Licences\GPLv3.txt" Link="Licences\GPLv3.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\Licences\LICENCE.txt" Link="Licences\LICENCE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
</Project>
